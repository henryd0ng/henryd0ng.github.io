---
import RobodojoLayout from '../../../../layouts/RobodojoLayout.astro';
import { projectMeta, tasks, taskBatches, taskCategories, taskStatuses } from '../../../../data/robodojo-contact';
import type { Lang } from '../../../../data/site';

export function getStaticPaths() {
  return ['zh', 'en'].map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const link = '/' + lang + '/projects/robodojo-contact/';
const tr = (cn: string, en: string) => zh ? cn : en;
const counts = Object.fromEntries(taskStatuses.map(({ id }) => [id, tasks.filter(task => task.status === id).length]));
const pending = counts.not_started;
const videos = tasks.reduce((total, task) => total + (task.media?.videos?.length ?? 0), 0);
const trajectories = tasks.reduce((total, task) => total + (task.trajectoryCount ?? 0), 0);
const featured = tasks.find(task => task.media?.videos?.length);
const heroClip = featured?.media?.videos?.[0];
const mediaKind = {
  accepted: tr('验收视频', 'Acceptance clip'),
  diagnostic: tr('诊断片段', 'Diagnostic clip'),
  development: tr('开发记录', 'Development clip'),
};
const clipNotice = {
  accepted: tr('参考片段', 'Reference clip'),
  diagnostic: tr('用于观察接触细节', 'Shows a close-up of the contact'),
  development: tr('开发阶段记录', 'Development record'),
};
const categoryNames = Object.fromEntries(taskCategories.map(category => [category.id, category.label[lang]]));
const batchNames = Object.fromEntries(taskBatches.map(batch => [batch.id, batch.label[lang]]));
const statusNames = Object.fromEntries(taskStatuses.map(status => [status.id, status.label[lang]]));
const formattedTasks = tr('{count} 项任务', '{count} tasks');
---
<RobodojoLayout lang={lang} title={projectMeta.title} description={projectMeta.description[lang]} pending={pending}>
  <main id="top" data-rb-catalog>
    <section class="rb-wrap rb-hero">
      <p class="rb-eyebrow">{tr('ROBOT MANIPULATION BENCHMARK', 'ROBOT MANIPULATION BENCHMARK')}</p>
      <h1>{projectMeta.title}</h1>
      <p class="rb-subtitle">{projectMeta.subtitle[lang]}</p>
      <p class="rb-lede">{projectMeta.description[lang]}</p>
      {heroClip && (
        <div class="rb-stage">
          <video data-rb-hero muted loop playsinline controls preload="metadata" poster={projectMeta.heroPoster ?? heroClip.poster ?? featured?.media?.image} aria-label={tr('项目示意动画', 'Project schematic animation')}>
            <source src={heroClip.src} type="video/mp4" />
          </video>
          <div class="rb-stage-overlay">
            <div><span class="rb-stage-label">{tr('示意动画 · 非实验录像', 'SCHEMATIC · NOT EXPERIMENTAL FOOTAGE')}</span><strong>{heroClip.label[lang]}</strong></div>
            <button class="rb-round" type="button" data-rb-hero-toggle data-play={tr('播放演示', 'Play animation')} data-pause={tr('暂停演示', 'Pause animation')} aria-label={tr('播放演示', 'Play animation')} aria-pressed="false">▶</button>
          </div>
          <p class="rb-media-error" data-rb-hero-error hidden>{tr('视频无法加载。', 'The video could not load.')} <a href={heroClip.src}>{tr('打开源文件', 'Open the video file')}</a></p>
        </div>
      )}
      <div class="rb-metrics" aria-label={tr('演示目录统计', 'Demo catalog totals')}>
        <div><strong>{tasks.length}</strong><span>{tr('示例任务', 'Example tasks')}</span></div>
        <div><strong>{videos}</strong><span>{tr('示意视频', 'Schematic clips')}</span></div>
        <div><strong>{trajectories}</strong><span>{tr('已登记参考轨迹', 'Registered trajectories')}</span></div>
      </div>
      <p class="rb-demo-tag">{projectMeta.notice[lang]}</p>
    </section>

    <section class="rb-wrap" aria-labelledby="batches-title">
      <div class="rb-banner">
        <div>
          <p class="rb-eyebrow">{tr('TASK BATCHES', 'TASK BATCHES')}</p>
          <h2 id="batches-title">{tr('任务批次与规格', 'Task batches & specifications')}</h2>
          <p>{tr('按场景批次进入任务集，查看初始摆放、执行步骤与验收条件。', 'Browse by scene batch, then explore the initial setup, task steps, and acceptance criteria.')}</p>
          <div class="rb-batch-links">
            {taskBatches.map(batch => <a class="rb-link" href={link + '#batch=' + batch.id}>{batch.label[lang]} ↗</a>)}
            <a class="rb-link" href={link + '#not-started'}>{tr('未开始任务', 'Not started')} ↗</a>
          </div>
        </div>
        <div class="rb-batch-links">
          {taskBatches.map(batch => <a class="rb-cta" href={link + 'specs/' + batch.id + '/'}>{batch.label[lang]}{tr('规格', ' specs')} ↗</a>)}
        </div>
      </div>
    </section>

    <section id="tasks" class="rb-wrap rb-catalog" aria-labelledby="tasks-title">
      <span id="not-started" aria-hidden="true"></span>
      <div class="rb-section-head">
        <div><p class="rb-eyebrow">{tr('BENCHMARK CATALOG', 'BENCHMARK CATALOG')}</p><h2 id="tasks-title">{tr('场景任务集', 'Task catalog')}</h2></div>
        <p>{tr('按开发状态或接触类型筛选，打开卡片可查看视频和任务详情。', 'Filter by development status or contact type. Open any card to see its media and task details.')}</p>
      </div>

      <div class="rb-controls">
        <div class="rb-filters" role="group" aria-label={tr('任务状态', 'Task status')}>
          <button type="button" class="rb-filter" data-rb-filter="all" aria-pressed="true">{tr('全部', 'All')} <span>{tasks.length}</span></button>
          {taskStatuses.map(status => <button type="button" class="rb-filter" data-rb-filter={status.id} aria-pressed="false">{status.label[lang]} <span>{counts[status.id]}</span></button>)}
        </div>
        <select class="rb-select" data-rb-category aria-label={tr('任务类别', 'Task category')}>
          <option value="">{tr('全部类别', 'All categories')}</option>
          {taskCategories.map(category => <option value={category.id}>{category.label[lang]}</option>)}
        </select>
        <select class="rb-select" data-rb-batch aria-label={tr('任务批次', 'Task batch')}>
          <option value="">{tr('全部批次', 'All batches')}</option>
          {taskBatches.map(batch => <option value={batch.id}>{batch.label[lang]}</option>)}
        </select>
        <label class="rb-search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <input type="search" data-rb-search placeholder={tr('搜索名称、类别或编号', 'Search name, category, or ID')} aria-label={tr('搜索任务', 'Search tasks')} />
        </label>
      </div>

      <div class="rb-results">
        <span role="status" data-rb-count data-format={formattedTasks}>{formattedTasks.replace('{count}', String(tasks.length))}</span>
        <button type="button" data-rb-clear class="rb-link" hidden>{tr('清除筛选', 'Clear filters')}</button>
        <span>{tr('目录快照', 'Catalog snapshot')} · <time datetime={projectMeta.snapshotDate}>{projectMeta.snapshotDate}</time></span>
      </div>

      <div class="rb-grid">
        {tasks.map(task => {
          const clip = task.media?.videos?.[0];
          const image = clip?.poster ?? task.media?.image;
          const specUrl = link + 'specs/' + task.batch + '/#' + task.id;
          const search = [
            task.id, task.title.zh, task.title.en, task.description.zh, task.description.en,
            categoryNames[task.category], batchNames[task.batch], ...task.tags,
          ].join(' ');
          return (
            <article class="rb-card" data-rb-card data-id={task.id} data-status={task.status} data-category={task.category} data-batch={task.batch} data-search={search}>
              <button class="rb-card-button" type="button" data-rb-open={task.id} aria-haspopup="dialog" aria-label={task.title[lang] + ' · ' + (clip ? tr('播放视频', 'Play video') : tr('查看详情', 'View details'))}>
                <div class="rb-thumb">
                  {image
                    ? <img src={image} alt="" loading="lazy" width="960" height="540" />
                    : <div class="rb-media-placeholder"><span aria-hidden="true">⊹</span>{tr('任务规格', 'Task specification')}</div>
                  }
                  <span class="rb-chip">{clip ? task.demo ? tr('示意视频', 'Schematic clip') : mediaKind[clip.kind] : image ? tr('静态场景', 'Still scene') : tr('规格', 'Spec')}</span>
                  <span class="rb-play" aria-hidden="true">{clip ? '▶' : '↗'}</span>
                </div>
                <div class="rb-card-body">
                  <p class="rb-kicker">{categoryNames[task.category]}{task.demo && ' · ' + tr('示例', 'Example')}</p>
                  <h3>{task.title[lang]}</h3>
                  <div class="rb-card-foot"><span class="rb-status" data-status={task.status}>{statusNames[task.status]}</span><span class="rb-card-id">{task.id}</span></div>
                </div>
              </button>
              <template data-rb-template={task.id}>
                {clip ? (
                  <div class="rb-detail-media">
                    <video controls playsinline preload="metadata" poster={clip.poster ?? task.media?.image} data-rb-clip-video aria-label={task.title[lang] + ' · ' + tr('视频', 'Video')}></video>
                    <p class="rb-media-error" data-rb-clip-error hidden>{tr('此视频无法在页面内加载。', 'This clip could not be loaded in the player.')} <a data-rb-source href={clip.src}>{tr('打开视频源文件', 'Open the video file')}</a></p>
                  </div>
                ) : image ? <div class="rb-detail-media"><img src={image} alt={task.media?.alt[lang] ?? task.title[lang]} width="960" height="540" /></div> : null}
                <div class="rb-detail-copy">
                  <p class="rb-kicker">{categoryNames[task.category]} · {batchNames[task.batch]}</p>
                  <h2 id="rb-detail-title">{task.title[lang]}</h2>
                  <p>{task.description[lang]}</p>
                  <div class="rb-detail-meta"><span class="rb-status" data-status={task.status}>{statusNames[task.status]}</span><span>{task.id}</span>{task.demo && <span>{tr('示例任务', 'Example task')}</span>}{task.trajectoryCount !== undefined && <span>{task.trajectoryCount} {tr('条参考轨迹', 'reference trajectories')}</span>}</div>
                  {clip && <div class="rb-clips" role="group" aria-label={tr('切换视频', 'Switch clips')}>
                    {task.media?.videos?.map((video, index) => <button type="button" data-rb-clip={video.src} data-poster={video.poster ?? task.media?.image} data-kind={task.demo ? undefined : mediaKind[video.kind]} data-notice={task.demo ? tr('示意动画 · 非实验录像', 'Schematic clip · Not experimental footage') : clipNotice[video.kind]} aria-pressed={index === 0}>{video.label[lang]}</button>)}
                  </div>}
                  {clip && <p class="rb-kicker" aria-live="polite" data-rb-clip-note></p>}
                  <a class="rb-spec-link" href={specUrl}>{tr('查看完整任务规格', 'Read task specification')} ↗</a>
                  <button type="button" class="rb-link" data-rb-copy-link data-copied={tr('链接已复制', 'Link copied')} data-copy-error={tr('请复制地址栏中的链接', 'Copy the URL from the address bar')}>{tr('复制任务链接', 'Copy task link')}</button>
                  <p class="rb-sr-only" role="status" data-rb-copy-status></p>
                </div>
              </template>
              <noscript><a href={specUrl}>{tr('查看任务规格', 'Read the task specification')}</a></noscript>
            </article>
          );
        })}
      </div>
      <p class="rb-empty" data-rb-empty hidden>{tr('没有符合条件的任务。试试其他关键词或筛选项。', 'No tasks match these filters. Try different keywords or filters.')}</p>
      <p class="rb-note">{tr('示例状态仅用于演示目录交互。静态场景不计入视频或参考轨迹；示意视频不代表真实实验或验收结果。', 'Example statuses demonstrate the catalog. Still scenes do not count as videos or trajectories. Schematic clips are not experimental or acceptance results.')}</p>
    </section>

    <section id="about" class="rb-about">
      <div class="rb-wrap rb-about-inner">
        <div><p class="rb-eyebrow">{tr('PROJECT OVERVIEW', 'PROJECT OVERVIEW')}</p><h2>{tr('项目介绍', 'About the project')}</h2></div>
        <div>
          <p>{tr('robodojo-contact 面向接触丰富的机器人操作任务。这里把每个场景的初始条件、目标、参考媒体和验收条件放在一起，便于浏览和对照。', 'robodojo-contact is a home for contact-rich robot manipulation tasks. Each scene brings its setup, objective, reference media, and acceptance criteria into one place.')}</p>
          <p>{tr('目录目前使用可替换的示例内容。后续可添加真实场景图、仿真或实机视频、参考轨迹及任务配置。', 'The catalog currently uses replaceable examples. Real scene previews, simulation or hardware footage, reference trajectories, and task configurations can be added as they become available.')}</p>
          <div class="rb-downloads">
            <a class="rb-link" href="/robodojo-contact/downloads/tasks.json" download>{tr('任务数据 JSON', 'Task data JSON')} ↓</a>
            <a class="rb-link" href="/robodojo-contact/downloads/guide.md" download>{tr('规格指南', 'Specification guide')} ↓</a>
            <a class="rb-link" href="/robodojo-contact/downloads/validation.json" download>{tr('目录校验', 'Catalog validation')} ↓</a>
            <a class="rb-link" href="/robodojo-contact/downloads/assets.zip" download>{tr('示意资产包', 'Schematic asset pack')} ↓</a>
            <a class="rb-link" href="/robodojo-contact/contact-board.svg" download>{tr('场景示意图', 'Scene illustration')} ↓</a>
            {projectMeta.codeUrl && <a class="rb-link" href={projectMeta.codeUrl}>{tr('项目代码', 'Project code')} ↗</a>}
          </div>
        </div>
      </div>
    </section>
    <dialog class="rb-dialog" data-rb-dialog aria-labelledby="rb-detail-title">
      <button class="rb-close" type="button" data-rb-close aria-label={tr('关闭任务详情', 'Close task details')}>×</button>
      <div data-rb-detail></div>
    </dialog>
  </main>
</RobodojoLayout>

<script>
  import '../../../../scripts/robodojo-catalog';
</script>
