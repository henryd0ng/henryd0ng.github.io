---
import Base from '../layouts/Base.astro';
import PublicationList from './PublicationList.astro';
import { profile, home, type Lang } from '../data/site';
const { lang } = Astro.props as {lang: Lang};
const zh = lang === 'zh';
const sections = [home.interests, home.education, home.research, home.internship]
  .map(section => ({ title: section.title[lang], items: section.items.filter(item => item[lang]).map(item => item[lang]) }))
  .filter(section => section.items.length);
const links = [
  { label: 'GitHub', href: profile.github },
  ...home.links.filter(link => link.href).map(link => ({ label: link.label[lang], href: link.href })),
];
---
<Base lang={lang} title={zh ? '个人主页' : 'Home'}>
 <section class="biography">
  <h1 class="sr-only">{profile.name}</h1>
  <blockquote><p>{home.lead[lang]}</p></blockquote>
  <p>{profile.intro[lang]}</p>
  <p>{home.linksLabel[lang]}{links.map((link, index) => <>{index > 0 && (zh ? '、' : ', ')}<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></>)}{zh ? '。' : '.'}</p>
 </section>
 {sections.map(section => <section class="academic-section">
  <h2>{section.title}</h2>
  <ul>{section.items.map(item => <li>{item}</li>)}</ul>
 </section>)}
 <section class="academic-section">
  <h2>{zh ? '论文' : 'Publications'}</h2>
  <PublicationList lang={lang}/>
 </section>
</Base>
