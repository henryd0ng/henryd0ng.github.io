---
import { blogCategories, type Lang } from '../data/site';

interface Props { lang: Lang; active: string }
const { lang, active } = Astro.props;
const zh = lang === 'zh';
---
<nav class="blog-categories" aria-label={zh ? '博客分类' : 'Blog categories'}>
  {blogCategories.map(category => (
    <a href={`/${lang}/blog/category/${category.id}/`} aria-current={active === category.id ? 'page' : undefined}>{category.name[lang]}</a>
  ))}
</nav>
