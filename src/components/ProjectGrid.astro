---
import { projects, type Lang } from '../data/site';
import { projectMeta } from '../data/robodojo-contact';

const { lang } = Astro.props as { lang: Lang };
---
<div class="project-grid">
    <article class="project-card">
      <div class="project-info">
        <h3><a href={`/${lang}/projects/robodojo-contact/`}>{projectMeta.title}</a></h3>
        <p>{projectMeta.description[lang]}</p>
        <p class="project-tags">{lang === 'zh' ? '机器人操作 · 基准测试' : 'Robot manipulation · Benchmark'}</p>
      </div>
    </article>
    {projects.map(project => (
      <article class="project-card">
        <div class="project-info">
          <h3><a href={`/${lang}/projects/${project.slug}/`}>{project.title[lang]}</a></h3>
          <p>{project.description[lang]}</p>
          {project.tags.length > 0 && <p class="project-tags">{project.tags.join(' · ')}</p>}
        </div>
      </article>
    ))}
</div>
