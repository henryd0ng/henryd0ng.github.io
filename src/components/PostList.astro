---
import { type Lang, posts } from '../data/site';

const { lang, limit } = Astro.props as { lang: Lang; limit?: number };
const items = limit === undefined ? posts : posts.slice(0, limit);
const zh = lang === 'zh';
---
{items.length ? (
  <div class="post-list">
    {items.map(post => (
      <article class="post-row">
        <time datetime={post.date}>{post.date}</time>
        <div class="post-text">
          <h3 class="post-title"><a href={`/${lang}/blog/${post.slug}/`}>{post.title[lang]}</a></h3>
          <p>{post.excerpt[lang]}</p>
          <p class="post-category">{post.category[lang]} · {post.readTime} {zh ? '分钟阅读' : 'min read'}</p>
        </div>
      </article>
    ))}
  </div>
) : <p class="empty-state">{zh ? '待补充。' : 'To be added.'}</p>}
