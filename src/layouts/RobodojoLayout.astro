---
import '../styles/robodojo-contact.css';
import type { Lang } from '../data/site';

interface Props { lang: Lang; title: string; description: string; pending?: number }
const { lang, title, description, pending } = Astro.props;
const zh = lang === 'zh';
const prefix = `/${lang}/projects/robodojo-contact/`;
const counterpart = Astro.url.pathname.replace(/^\/(zh|en)\//, zh ? '/en/' : '/zh/');
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'} class="rb-page">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <title>{title} · Haoyu Dong</title>
  <link rel="icon" href="/favicon.svg" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" hreflang={zh ? 'en' : 'zh-CN'} href={new URL(counterpart, Astro.site)} />
</head>
<body>
  <a class="rb-sr-only" href="#top">{zh ? '跳到正文' : 'Skip to content'}</a>
  <header class="rb-nav-shell">
    <nav class="rb-nav" aria-label={zh ? '项目导航' : 'Project navigation'}>
      <a class="rb-brand" href={prefix}>robodojo-contact<span aria-hidden="true">.</span></a>
      <div class="rb-nav-links">
        <a href={prefix + '#about'}>{zh ? '项目介绍' : 'Overview'}</a>
        <a class="rb-pending-link" href={prefix + '#not-started'}>{zh ? '未开始' : 'Not started'}{pending !== undefined ? ` (${pending})` : ''}</a>
      </div>
      <div class="rb-nav-actions">
        <a class="rb-lang" href={counterpart} data-rb-language lang={zh ? 'en' : 'zh-CN'} aria-label={zh ? '切换到英文' : 'Switch to Chinese'}>{zh ? 'EN' : '中文'}</a>
        <a class="rb-cta" href={prefix + '#tasks'}>{zh ? '场景任务集' : 'Task catalog'}</a>
      </div>
    </nav>
  </header>
  <slot />
  <footer class="rb-wrap rb-footer">
    <a class="rb-brand" href={prefix}>robodojo-contact<span aria-hidden="true">.</span></a>
    <span>{zh ? '接触操作基准 · Haoyu Dong' : 'Contact manipulation benchmark · Haoyu Dong'}</span>
    <a href={`/${lang}/projects/`}>{zh ? '返回个人网站' : 'Personal website'}</a>
    <span class="rb-credit">NVIDIA SimReady · CC BY 4.0 · <a href="/robodojo-contact/downloads/guide.md">{zh ? '资产来源与许可' : 'Asset sources & licenses'}</a></span>
  </footer>
  <script>
    document.querySelector<HTMLAnchorElement>('[data-rb-language]')?.addEventListener('click', event => {
      const link = event.currentTarget as HTMLAnchorElement;
      const next = new URL(link.href);
      next.hash = location.hash;
      link.href = next.href;
    });
  </script>
</body>
</html>
